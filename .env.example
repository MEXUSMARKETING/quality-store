# Password for /admin
ADMIN_PASSWORD=

# Supabase (one account for all projects). Supabase → Project Settings.
# Postgres connection string – use the "Transaction pooler" URI (port 6543). POSTGRES_URL also works.
DATABASE_URL=
# Image storage (Supabase Storage, bucket "products" is created automatically)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server only – never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback for image uploads if Supabase Storage is not configured
BLOB_READ_WRITE_TOKEN=
